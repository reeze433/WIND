{{#*inline "vit-group"}}
<section class="vit-panel vit-group-{{type}}" data-panel-type="{{type}}" {{#if scalable}}data-card-scale="{{cardScale}}" style="--vit-card-scale:{{cardScale}};--vit-card-text-scale:{{cardTextScale}}"{{/if}}>
<h2><span class="wind-panel-title"><span>{{label}}</span></span><span class="vit-group-controls">{{#if scalable}}<small class="vit-prepared-count" title="{{localize 'VIT.PreparedCount'}}">{{localize 'VIT.PreparedCount'}}: {{preparedCount}}</small>{{/if}}
{{#if scalable}}<button type="button" data-action="togglePanel" data-type="{{type}}" title="{{localize 'VIT.TogglePanel'}}" aria-label="{{localize 'VIT.TogglePanel'}}: {{label}}" aria-expanded="{{#if panelClosed}}false{{else}}true{{/if}}"><i class="fa-solid {{#if panelClosed}}fa-chevron-down{{else}}fa-chevron-up{{/if}}" aria-hidden="true"></i></button><button type="button" data-action="movePanel" data-type="{{type}}" data-direction="-1" title="{{localize 'VIT.MovePanelUp'}}" aria-label="{{localize 'VIT.MovePanelUp'}}: {{label}}" {{#if panelFirst}}disabled{{/if}}><i class="fa-solid fa-arrow-up" aria-hidden="true"></i></button><button type="button" data-action="movePanel" data-type="{{type}}" data-direction="1" title="{{localize 'VIT.MovePanelDown'}}" aria-label="{{localize 'VIT.MovePanelDown'}}: {{label}}" {{#if panelLast}}disabled{{/if}}><i class="fa-solid fa-arrow-down" aria-hidden="true"></i></button><label class="vit-card-scale" title="{{localize 'VIT.CardScale'}}"><i class="fa-solid fa-up-right-and-down-left-from-center" aria-hidden="true"></i><input type="range" min="60" max="150" step="5" value="{{cardScalePercent}}" data-type="{{type}}" aria-label="{{localize 'VIT.CardScale'}}: {{label}}"><output>{{cardScalePercent}}%</output></label><label class="vit-card-scale vit-card-text-scale" title="{{localize 'VIT.CardTextScale'}}"><i class="fa-solid fa-font" aria-hidden="true"></i><input type="range" min="60" max="150" step="5" value="{{cardTextScalePercent}}" data-type="{{type}}" aria-label="{{localize 'VIT.CardTextScale'}}: {{label}}"><output>{{cardTextScalePercent}}%</output></label>{{/if}}
<button type="button" data-action="filterCards" data-type="{{type}}" title="{{localize 'VIT.FilterCards'}}" aria-label="{{localize 'VIT.FilterCards'}}: {{label}}"><i class="fa-solid fa-filter" aria-hidden="true"></i></button>
{{#unless condition}}<button type="button" data-action="toggleCards" data-type="{{type}}" aria-label="{{localize 'VIT.CollapseCards'}}: {{label}}" title="{{localize 'VIT.CollapseCards'}}" aria-pressed="{{collapsed}}"><i class="fa-solid fa-grip" aria-hidden="true"></i></button>{{/unless}}
{{#if @root.editable}}<button type="button" data-action="createCard" data-type="{{type}}" aria-label="{{localize 'VIT.Add'}}: {{label}}">+</button>{{/if}}</span></h2>
<div class="wind-panel-body" {{#if panelClosed}}hidden{{/if}}>
<div class="wind-grid-viewport wind-list-viewport" {{#if scalable}}style="{{viewportStyle}}" aria-label="{{localize 'VIT.PanelResizeHint'}}"{{/if}}><div class="{{#if scalable}}wind-card-list{{else}}wind-legacy-cards{{/if}}" {{#if scalable}}data-list-type="{{type}}"{{/if}}>
{{#each items}}
{{#unless gridOverflow}}
{{#if iconCollapsed}}
<article class="wind-grid-icon draggable {{#if system.prepared}}wind-prepared{{else}}wind-unprepared{{/if}}" draggable="true" data-item-id="{{id}}" style="{{gridStyle}}">
<button type="button" class="wind-icon-open" data-action="editCard" aria-label="{{name}}" data-wind-tooltip-html="{{tooltip}}" data-tooltip-class="vit-item-tooltip"><img src="{{img}}" alt=""></button>
{{#if @root.editable}}<div class="wind-icon-actions"><button type="button" data-action="togglePrepared" title="{{#if system.prepared}}{{localize 'VIT.UnprepareCard'}}{{else}}{{localize 'VIT.PrepareCard'}}{{/if}}" aria-label="{{#if system.prepared}}{{localize 'VIT.UnprepareCard'}}{{else}}{{localize 'VIT.PrepareCard'}}{{/if}}: {{name}}" aria-pressed="{{system.prepared}}"><span class="wind-prepare-symbol" aria-hidden="true"></span></button><button type="button" data-action="toggleGridCard" title="{{localize 'VIT.ExpandCard'}}" aria-label="{{localize 'VIT.ExpandCard'}}: {{name}}"><i class="fa-solid fa-expand" aria-hidden="true"></i></button></div>{{/if}}
</article>
{{else}}
<article class="vit-card wind-grid-card draggable {{#if system.prepared}}wind-prepared{{else}}wind-unprepared{{/if}}" draggable="true" data-item-id="{{id}}" style="{{gridStyle}}">
<header><img src="{{img}}" alt="" data-wind-tooltip-html="{{tooltip}}" data-tooltip-class="vit-item-tooltip"><button type="button" data-action="editCard" data-wind-tooltip-html="{{tooltip}}" data-tooltip-class="vit-item-tooltip">{{name}}</button>{{#if system.hasTier}}<span class="vit-tier-badge tier-{{system.tier}}">{{system.tier}}</span>{{/if}}</header>
{{#if showQuantity}}<small>{{localize 'VIT.Quantity'}}: {{system.quantity}}</small>{{/if}}
{{#if system.chargesEnabled}}<small>{{localize 'VIT.Charges'}}: {{system.charges.value}} / {{system.charges.max}}</small>{{/if}}
{{#if system.chargeSourceId}}<small>{{localize 'VIT.SourceChargeCost'}} [{{chargeSourceName}}]: {{system.sourceChargeCost}}</small>{{/if}}
{{#if system.chargeReceiverId}}<small>{{localize 'VIT.ChargeReceiver'}} [{{chargeReceiverName}}]: {{#if system.chargeRestoreFull}}{{localize 'VIT.ChargeToMaximum'}}{{else}}+{{system.restoreChargeAmount}}{{/if}}</small>{{/if}}
{{#each chargeChildren}}<small>{{localize 'VIT.ChargeSourceFor'}} [{{name}}]: {{cost}}</small>{{/each}}
<div class="vit-description vit-item-rich">{{{descriptionHTML}}}</div>
{{#if system.inspirationEnabled}}<small>{{localize 'VIT.Cost'}}: {{system.cost}}</small>{{/if}}
<footer>{{#if @root.editable}}<button class="vit-use-item" type="button" data-action="rollItem" {{#if useDisabled}}disabled title="{{useReason}}"{{/if}}>{{localize 'VIT.UseItem'}}</button><button type="button" data-action="togglePrepared" title="{{#if system.prepared}}{{localize 'VIT.UnprepareCard'}}{{else}}{{localize 'VIT.PrepareCard'}}{{/if}}" aria-label="{{#if system.prepared}}{{localize 'VIT.UnprepareCard'}}{{else}}{{localize 'VIT.PrepareCard'}}{{/if}}: {{name}}" aria-pressed="{{system.prepared}}"><span class="wind-prepare-symbol" aria-hidden="true"></span></button><button type="button" data-action="publishCard" title="{{localize 'VIT.Publish'}}"><i class="fa-solid fa-comment" aria-hidden="true"></i></button><button type="button" data-action="deleteCard" title="{{localize 'VIT.Delete'}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{#if ../scalable}}<button type="button" data-action="toggleGridCard" title="{{localize 'VIT.CollapseCard'}}" aria-label="{{localize 'VIT.CollapseCard'}}: {{name}}"><i class="fa-solid fa-compress" aria-hidden="true"></i></button>{{/if}}{{/if}}</footer>
</article>
{{/if}}
{{/unless}}
{{else}}<p class="wind-grid-empty">{{localize 'VIT.CardListEmpty'}}</p>{{/each}}
</div></div>

{{#if (eq type "equipment")}}{{#each @root.groups}}{{#if (eq type "other")}}{{#if items.length}}{{> vit-group}}{{/if}}{{/if}}{{/each}}{{/if}}
</div></section>
{{/inline}}

<div class="vit-shell {{#unless editValues}}vit-values-locked{{/unless}}">
  <header class="vit-hero">
    <div class="vit-portrait">
      <img src="{{actor.img}}" alt="{{actor.name}}" {{#if editValues}}data-action="editImage" data-edit="img"{{/if}}>
      {{#if tokenizer}}{{#if editValues}}<button type="button" data-action="tokenizer" title="{{localize 'VIT.Tokenizer'}}"><i class="fa-solid fa-crop"></i></button>{{/if}}{{/if}}
      {{#unless limited}}<div class="vit-avatar-health" title="{{localize 'VIT.Health'}}"><div class="vit-health-track"><span style="width:{{healthPercent}}%"></span></div><div class="vit-health-number">{{#if editValues}}<input aria-label="{{localize 'VIT.Health'}}" type="number" name="system.health.value" value="{{system.health.value}}" min="0" max="{{system.health.max}}"><span>/ {{system.health.max}}</span>{{else}}<span class="vit-health-readout">{{system.health.value}} / {{system.health.max}}</span>{{/if}}</div></div>{{/unless}}
    </div>
    <div class="vit-identity"><input class="vit-name" name="name" aria-label="{{localize 'VIT.Name'}}" value="{{actor.name}}" {{#unless editValues}}disabled{{/unless}}>
      <input class="vit-subtitle" name="system.archetype" aria-label="{{localize 'VIT.Subtitle'}}" {{#if editValues}}placeholder="{{localize 'VIT.Subtitle'}}"{{/if}} value="{{system.archetype}}" {{#unless editValues}}disabled{{/unless}}>
      {{#unless limited}}<div class="vit-level-inline"><small>{{localize 'VIT.LevelShort'}}</small><input aria-label="{{localize 'VIT.Level'}}" title="{{localize 'VIT.Level'}}" type="number" name="system.level" value="{{system.level}}" min="1" {{#unless editValues}}disabled{{/unless}}><span>(</span><small>{{localize 'VIT.ExperienceShort'}}</small><input aria-label="{{localize 'VIT.Experience'}}" title="{{localize 'VIT.Experience'}}" type="number" name="system.experience.value" value="{{system.experience.value}}" min="0" {{#unless editValues}}disabled{{/unless}}><span>)</span></div>{{/unless}}
    </div>
    {{#unless limited}}<div class="vit-attributes vit-header-attributes">{{#each attributes}}<div class="vit-attribute">
      {{#if @root.editValues}}<div class="vit-attribute-value"><i class="fa-solid fa-{{icon}}" aria-hidden="true"></i><input aria-label="{{label}}" type="number" name="system.attributes.{{key}}" value="{{baseValue}}" min="0" max="6"></div>
      {{else}}<button class="vit-attribute-roll" type="button" data-action="roll" data-attribute="{{key}}" title="{{localize 'VIT.Roll'}}: {{label}}" aria-label="{{localize 'VIT.Roll'}}: {{label}}" {{#unless ../editable}}disabled{{/unless}}><i class="fa-solid fa-{{icon}}" aria-hidden="true"></i><strong>{{value}}</strong></button>{{/if}}
      <small>{{label}}</small><div class="vit-branches"><button type="button" data-action="rollBranch" data-branch="attack" data-attribute="{{key}}" title="{{localize 'VIT.Attack'}}: {{label}}" {{#unless @root.editable}}disabled{{/unless}}><b>{{attack}}</b><i class="fa-solid fa-sword" aria-hidden="true"></i></button><button type="button" data-action="rollBranch" data-branch="defense" data-attribute="{{key}}" title="{{localize 'VIT.Defense'}}: {{label}}" {{#unless @root.editable}}disabled{{/unless}}><b>{{defense}}</b><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></button></div></div>{{/each}}</div>
    <div class="vit-header-utility">
      <div class="vit-header-conditions" aria-label="{{localize 'VIT.condition'}}">{{#each groups}}{{#if condition}}{{#each items}}<article class="vit-condition-token draggable" data-item-id="{{id}}"><button data-wind-tooltip-html="{{tooltip}}" data-tooltip-class="vit-item-tooltip" class="vit-condition-image" type="button" data-action="editCard" aria-label="{{name}}"><img src="{{img}}" alt=""></button>{{#if @root.editValues}}<button class="vit-condition-remove" type="button" data-action="deleteCard" title="{{localize 'VIT.Delete'}}: {{name}}" aria-label="{{localize 'VIT.Delete'}}: {{name}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}</article>{{/each}}{{/if}}{{/each}}{{#each statuses}}<article class="vit-condition-token" data-status-id="{{statusId}}" data-effect-id="{{effectId}}"><button data-wind-tooltip-html="{{tooltip}}" data-tooltip-class="vit-item-tooltip" class="vit-condition-image" type="button" data-action="openStatus" aria-label="{{name}}"><img src="{{img}}" alt=""></button>{{#if @root.editValues}}<button class="vit-condition-remove" type="button" data-action="removeStatus" aria-label="{{localize 'VIT.Delete'}}: {{name}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}</article>{{/each}}{{#if editValues}}<button class="vit-condition-add" type="button" data-action="createCard" data-type="condition" title="{{localize 'VIT.Add'}}: {{localize 'VIT.condition'}}" aria-label="{{localize 'VIT.Add'}}: {{localize 'VIT.condition'}}"><i class="fa-solid fa-plus"></i></button>{{/if}}</div>
      <div class="vit-resource-line"><span class="vit-currencies">{{#each currencies}}<label>{{name}}<input aria-label="{{name}}" type="number" name="system.currencies.{{id}}" value="{{value}}" min="0" step="1" {{#unless ../editable}}disabled{{/unless}}></label>{{/each}}{{#if editable}}<button class="vit-currency-transfer" type="button" data-action="transferCurrency" title="{{localize 'VIT.TransferCurrency'}}" aria-label="{{localize 'VIT.TransferCurrency'}}"><i class="fa-solid fa-money-bill-transfer" aria-hidden="true"></i></button>{{/if}}</span>{{#if customResources.length}}<span class="vit-custom-resources">{{#each customResources}}<span class="vit-custom-resource {{#if error}}invalid{{/if}}" title="{{#if error}}{{error}}{{else}}{{name}}{{/if}}"><span class="vit-custom-resource-name">{{name}}</span><span class="vit-custom-resource-value">{{#if @root.editValues}}<input type="number" data-resource-id="{{id}}" aria-label="{{name}}" value="{{value}}" min="0" max="{{maximum}}" step="1">{{else}}<strong>{{value}}</strong>{{/if}}<span>/ {{maximum}}</span></span>{{#if @root.editValues}}<button type="button" class="vit-custom-resource-gear" data-action="configureResource" data-resource-id="{{id}}" title="{{localize 'VIT.ResourceConfigure'}}: {{name}}" aria-label="{{localize 'VIT.ResourceConfigure'}}: {{name}}"><i class="fa-solid fa-gear" aria-hidden="true"></i></button>{{/if}}</span>{{/each}}</span>{{/if}}<span class="vit-inspiration-inline" aria-label="{{localize 'VIT.Inspiration'}}: {{system.inspiration.value}}">{{#if editInspiration}}<label class="vit-inspiration-edit"><i class="fa-solid fa-coins" aria-hidden="true"></i><input type="number" name="system.inspiration.value" aria-label="{{localize 'VIT.Inspiration'}}" value="{{system.inspiration.value}}" min="0" step="1"></label>{{else}}<button class="vit-inspiration-spend" type="button" data-action="resource" data-resource="inspiration" data-delta="-1" title="{{localize 'VIT.SpendOneInspiration'}}" aria-label="{{localize 'VIT.SpendOneInspiration'}}" {{#unless canSpendInspiration}}disabled{{/unless}}><i class="fa-solid fa-coins" aria-hidden="true"></i><strong>{{system.inspiration.value}}</strong></button>{{/if}}{{#if editable}}<button class="vit-sheet-coin" type="button" data-action="coin">{{localize 'VIT.CoinFlip'}}</button>{{/if}}</span></div>
    </div>{{/unless}}
  </header>
  {{#unless limited}}<div class="vit-body">
    <nav class="vit-side-tabs" role="tablist" aria-orientation="vertical" aria-label="{{localize 'VIT.CharacterTabs'}}">
      <button type="button" role="tab" id="{{sheetId}}-equipment-tab" aria-controls="{{sheetId}}-equipment" aria-selected="{{gearTab}}" tabindex="{{#if gearTab}}0{{else}}-1{{/if}}" data-action="sheetTab" data-tab="equipment" title="{{localize 'VIT.EquipmentTab'}}" aria-label="{{localize 'VIT.EquipmentTab'}}"><i class="fa-solid fa-toolbox" aria-hidden="true"></i></button>
      <button type="button" role="tab" id="{{sheetId}}-information-tab" aria-controls="{{sheetId}}-information" aria-selected="{{informationTab}}" tabindex="{{#if informationTab}}0{{else}}-1{{/if}}" data-action="sheetTab" data-tab="information" title="{{localize 'VIT.InformationTab'}}" aria-label="{{localize 'VIT.InformationTab'}}"><i class="fa-solid fa-book-open" aria-hidden="true"></i></button>
      <button type="button" role="tab" id="{{sheetId}}-effects-tab" aria-controls="{{sheetId}}-effects" aria-selected="{{effectsTab}}" tabindex="{{#if effectsTab}}0{{else}}-1{{/if}}" data-action="sheetTab" data-tab="effects" title="{{localize 'VIT.ItemEffectsTab'}}" aria-label="{{localize 'VIT.ItemEffectsTab'}}"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i></button>
    </nav>
    <main class="vit-tab-content"><div class="vit-sections" role="tabpanel" id="{{sheetId}}-equipment" aria-labelledby="{{sheetId}}-equipment-tab" data-sheet-panel="equipment" {{#unless gearTab}}hidden{{/unless}}>{{#each groups}}{{#unless condition}}{{#unless (eq type "other")}}{{> vit-group}}{{/unless}}{{/unless}}{{/each}}</div>
    <div class="vit-sections" role="tabpanel" id="{{sheetId}}-information" aria-labelledby="{{sheetId}}-information-tab" data-sheet-panel="information" {{#unless informationTab}}hidden{{/unless}}>
    <section class="vit-panel vit-bio"><h2>{{localize 'VIT.Biography'}}</h2>{{#if editable}}<prose-mirror name="system.biography" value="{{system.biography}}" toggled>{{{biographyHTML}}}</prose-mirror>{{else}}<div class="vit-rich-view">{{{biographyHTML}}}</div>{{/if}}</section>
    <section class="vit-panel vit-bio"><h2>{{localize 'VIT.Notes'}}</h2>{{#if editable}}<prose-mirror name="system.notes" value="{{system.notes}}" toggled>{{{notesHTML}}}</prose-mirror>{{else}}<div class="vit-rich-view">{{{notesHTML}}}</div>{{/if}}</section>
    </div><div class="vit-sections" role="tabpanel" id="{{sheetId}}-effects" aria-labelledby="{{sheetId}}-effects-tab" data-sheet-panel="effects" {{#unless effectsTab}}hidden{{/unless}}>
    <section class="vit-panel"><h2>{{localize 'VIT.ItemEffectsTab'}}</h2><div class="vit-expanded-effects">{{#each activeEffects}}<article class="vit-expanded-effect {{#if disabled}}disabled{{/if}}" data-effect-id="{{id}}"><header><img src="{{img}}" alt=""><strong>{{name}}</strong><small>{{#if disabled}}{{localize 'VIT.EffectDisabled'}}{{else}}{{localize 'VIT.EffectActive'}}{{/if}}</small></header>{{#if sourceName}}<small>{{localize 'VIT.EffectSource'}}: {{sourceName}}</small>{{/if}}<div class="vit-item-rich">{{{descriptionHTML}}}</div>{{#each changes}}<p class="vit-effect-change">{{label}}: <strong>{{value}}</strong></p>{{/each}}{{#if @root.editable}}<footer><button type="button" data-action="toggleEffect">{{#if disabled}}{{localize 'VIT.EffectEnable'}}{{else}}{{localize 'VIT.EffectDisable'}}{{/if}}</button><button type="button" data-action="deleteEffect">{{localize 'VIT.Delete'}}</button></footer>{{/if}}</article>{{else}}<p class="vit-empty">{{localize 'VIT.NoActiveEffects'}}</p>{{/each}}</div></section>
    </div></main></div>{{/unless}}
</div>

