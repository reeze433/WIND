<div class="vit-item-sheet-content">
{{#if itemEditing}}<div class="vit-item-body"><header><img src="{{item.img}}" data-action="editImage" data-edit="img" alt="{{item.name}}"><input name="name" value="{{item.name}}" {{#unless editable}}disabled{{/unless}}></header>
<nav class="vit-item-tabs" role="tablist" aria-label="{{localize 'VIT.ItemSections'}}"><button type="button" role="tab" data-action="itemTab" data-tab="description" aria-selected="{{itemDescriptionTab}}">{{localize 'VIT.ItemDescriptionTab'}}</button><button type="button" role="tab" data-action="itemTab" data-tab="activation" aria-selected="{{itemActivationTab}}">{{localize 'VIT.ItemActivationTab'}}</button></nav>
<section class="vit-item-tab-panel" data-item-panel="description" {{#unless itemDescriptionTab}}hidden{{/unless}}><details class="vit-item-group" data-item-group="metadata" open><summary><span>{{localize 'VIT.ItemGroupMetadata'}}</span></summary><div class="vit-item-group-content">
<label>{{localize 'VIT.Category'}}<select name="system.category" {{#unless editable}}disabled{{/unless}}>{{selectOptions categories selected=category}}</select></label>
<label>{{localize 'VIT.Price'}}<input type="number" name="system.price" value="{{system.price}}" min="0" {{#unless editable}}disabled{{/unless}}></label>
<label class="vit-check-label"><input type="checkbox" name="system.prepared" {{checked system.prepared}} {{#unless editable}}disabled{{/unless}}>{{localize 'VIT.Prepared'}}</label>
</div></details>
<details class="vit-item-group" data-item-group="public-description" open><summary>{{localize 'VIT.PublicDescription'}}</summary><section class="vit-item-editor">{{#if editable}}<prose-mirror name="system.description" value="{{descriptionValue}}" document-uuid="{{item.uuid}}">{{{descriptionHTML}}}</prose-mirror>{{else}}<div class="vit-rich-view vit-item-rich">{{{descriptionHTML}}}</div>{{/if}}</section></details>
{{#if editable}}<details class="vit-item-group" data-item-group="private-description" open><summary>{{localize 'VIT.PrivateDescription'}}</summary><section class="vit-item-editor"><prose-mirror name="system.privateDescription" value="{{privateDescriptionValue}}" document-uuid="{{item.uuid}}">{{{privateDescriptionHTML}}}</prose-mirror></section><p class="vit-hint">{{localize 'VIT.PrivateDescriptionHint'}}</p></details>{{/if}}</section>
<section class="vit-item-tab-panel" data-item-panel="activation" {{#unless itemActivationTab}}hidden{{/unless}}>
<details class="vit-item-group" data-item-group="modes" open><summary><span>{{localize 'VIT.AMtitle'}}</span> <small>({{actionModeViews.length}})</small></summary><div class="vit-item-group-content">
<p class="vit-hint">{{localize 'VIT.AMhelp'}}</p>
{{#each actionModeViews}}<div class="vit-action-mode"><div><strong>{{name}}</strong>{{#if description}}<p>{{description}}</p>{{/if}}<small>{{summary}}</small></div>{{#if ../editable}}<button type="button" data-action="editActionMode" data-mode-id="{{id}}" title="{{localize 'VIT.AMedit'}}"><i class="fas fa-cog"></i></button><button type="button" data-action="deleteActionMode" data-mode-id="{{id}}" title="{{localize 'VIT.AMdelete'}}"><i class="fas fa-trash"></i></button>{{/if}}</div>{{else}}<p>{{localize 'VIT.AMempty'}}</p>{{/each}}
{{#if editable}}<button type="button" data-action="addActionMode"><i class="fas fa-plus"></i> {{localize 'VIT.AMadd'}}</button>{{/if}}
</div></details>
<p class="vit-hint">{{localize 'VIT.ItemCommonSettingsHint'}}</p>
<details class="vit-item-group" data-item-group="roll" {{#unless actionModeViews.length}}open{{/unless}}><summary><span>{{localize 'VIT.ItemGroupRoll'}}</span> {{#if system.rollEnabled}}<small>{{lookup attributes system.attribute}}</small>{{/if}}</summary><div class="vit-item-group-content">
<label class="vit-check-label"><input type="checkbox" name="system.hasTier" {{checked system.hasTier}} {{#unless editable}}disabled{{/unless}}>{{localize 'VIT.HasTier'}}</label>
{{#if system.hasTier}}<label>{{localize 'VIT.Tier'}}<select name="system.tier" {{#unless editable}}disabled{{/unless}}>{{selectOptions tiers selected=system.tier}}</select></label>{{/if}}
<label class="vit-check-label"><input type="checkbox" name="system.rollEnabled" {{checked system.rollEnabled}} {{#unless editable}}disabled{{/unless}}>{{localize 'VIT.RollEnabled'}}</label>
{{#if system.rollEnabled}}<label>{{localize 'VIT.RollBranch'}}<select name="system.rollBranch" {{#unless editable}}disabled{{/unless}}>{{selectOptions branches selected=system.rollBranch}}</select></label><label>{{localize 'VIT.Attribute'}}<select name="system.attribute" {{#unless editable}}disabled{{/unless}}>{{selectOptions attributes selected=system.attribute}}</select></label>
<label class="vit-check-label"><input type="checkbox" name="system.dealsDamage" {{checked system.dealsDamage}} {{#unless editable}}disabled{{/unless}}>{{localize 'VIT.DealsDamage'}}</label>
{{/if}}
</div></details>
<details class="vit-item-group" data-item-group="quantity" ><summary><span>{{localize 'VIT.ItemGroupQuantity'}}</span> <small>{{system.quantity}}</small></summary><div class="vit-item-group-content">
<label>{{localize 'VIT.Quantity'}}<input type="number" name="system.quantity" value="{{system.quantity}}" min="0" {{#unless editable}}disabled{{/unless}}></label>
<label>{{localize 'VIT.QuantityUsage'}}<select name="system.quantityUsage" {{#unless editable}}disabled{{/unless}}>{{selectOptions quantityUsageModes selected=system.quantityUsage}}</select></label>{{#if consumesQuantity}}<label>{{localize 'VIT.QuantityCost'}}<input type="number" name="system.quantityCost" value="{{system.quantityCost}}" min="1" step="1" {{#unless editable}}disabled{{/unless}}></label>{{/if}}<p class="vit-hint">{{localize 'VIT.QuantityUsageHint'}}</p>
</div></details>
<details class="vit-item-group" data-item-group="resources" ><summary><span>{{localize 'VIT.ItemGroupResources'}}</span></summary><div class="vit-item-group-content">
<label class="vit-check-label"><input type="checkbox" name="system.inspirationEnabled" {{checked system.inspirationEnabled}} {{#unless editable}}disabled{{/unless}}>{{localize 'VIT.InspirationEnabled'}}</label>
{{#if system.inspirationEnabled}}<label>{{localize 'VIT.Cost'}}<input type="number" name="system.cost" value="{{system.cost}}" min="0" {{#unless editable}}disabled{{/unless}}></label>{{/if}}
<label>{{localize 'VIT.SpendCustomResource'}}<select name="system.customResourceId" {{#unless editable}}disabled{{/unless}}>{{selectOptions customResourceOptions selected=system.customResourceId}}</select></label>{{#if system.customResourceId}}<label>{{localize 'VIT.CustomResourceCost'}}<input type="number" name="system.customResourceCost" value="{{system.customResourceCost}}" min="1" step="1" {{#unless editable}}disabled{{/unless}}></label>{{/if}}
</div></details>
<details class="vit-item-group" data-item-group="charges" ><summary><span>{{localize 'VIT.ItemGroupCharges'}}</span> {{#if system.chargesEnabled}}<small>{{system.charges.value}} / {{system.charges.max}}</small>{{/if}}</summary><div class="vit-item-group-content">
<label class="vit-check-label"><input type="checkbox" name="system.restRecovery" {{checked system.restRecovery}} {{#unless editable}}disabled{{/unless}}>{{localize 'VIT.RestRecovery'}}</label><label class="vit-check-label"><input type="checkbox" name="system.chargesEnabled" {{checked system.chargesEnabled}} {{#unless editable}}disabled{{/unless}}>{{localize 'VIT.HasCharges'}}</label>
{{#if system.chargesEnabled}}<div class="vit-charge-fields"><label>{{localize 'VIT.ChargesCurrent'}}<input type="number" name="system.charges.value" value="{{system.charges.value}}" min="0" max="{{system.charges.max}}" step="1" {{#unless editable}}disabled{{/unless}}></label><label>{{localize 'VIT.ChargesMax'}}<input type="number" name="system.charges.max" value="{{system.charges.max}}" min="0" step="1" {{#if system.chargesMaxFormula}}disabled{{else}}{{#unless editable}}disabled{{/unless}}{{/if}}></label><label>{{localize 'VIT.ChargeCost'}}<input type="number" name="system.chargeCost" value="{{system.chargeCost}}" min="1" step="1" {{#unless editable}}disabled{{/unless}}></label></div>{{/if}}
{{#if system.chargesEnabled}}<label>{{localize 'VIT.ChargesMaxFormula'}}<input type="text" name="system.chargesMaxFormula" value="{{system.chargesMaxFormula}}" placeholder="Мышление * 3" {{#unless editable}}disabled{{/unless}}></label><p class="vit-hint">{{localize 'VIT.ChargesMaxFormulaHint'}}</p>{{#if chargeFormulaError}}<p class="vit-hint" role="alert">{{localize 'VIT.InvalidChargeFormula'}}</p>{{/if}}{{/if}}
</div></details>
<details class="vit-item-group" data-item-group="links" ><summary><span>{{localize 'VIT.ItemGroupLinks'}}</span></summary><div class="vit-item-group-content">
<section class="vit-charge-source" aria-label="{{localize 'VIT.ChargeSource'}}"><h3>{{localize 'VIT.ChargeSource'}}</h3>{{#if chargeSource}}<div class="vit-charge-source-name"><img src="{{chargeSource.img}}" alt=""><strong>{{chargeSource.name}}</strong>{{#if editable}}<button type="button" data-action="clearChargeSource" title="{{localize 'VIT.RemoveChargeSource'}}" aria-label="{{localize 'VIT.RemoveChargeSource'}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}</div>{{else}}<p>{{localize 'VIT.ChargeDropHint'}}</p>{{#if system.chargeSourceId}}<p class="vit-hint">{{localize 'VIT.ChargeSourceMissing'}}</p>{{#if editable}}<button type="button" data-action="clearChargeSource">{{localize 'VIT.RemoveChargeSource'}}</button>{{/if}}{{/if}}{{/if}}{{#if chargeSource}}<label>{{localize 'VIT.SourceChargeCost'}}{{#if chargeSource}} [{{chargeSource.name}}]{{/if}}<input type="number" name="system.sourceChargeCost" value="{{system.sourceChargeCost}}" min="1" step="1" {{#unless editable}}disabled{{/unless}}></label><p class="vit-hint">{{localize 'VIT.SourceChargeCostHint'}}</p>{{/if}}<p class="vit-hint">{{localize 'VIT.ChargeUseHint'}}</p></section>
<section class="vit-charge-source" data-charge-role="receiver" aria-label="{{localize 'VIT.ChargeReceiver'}}"><h3>{{localize 'VIT.ChargeReceiver'}}</h3>{{#if chargeReceiver}}<div class="vit-charge-source-name"><img src="{{chargeReceiver.img}}" alt=""><strong>{{chargeReceiver.name}}</strong>{{#if editable}}<button type="button" data-action="clearChargeReceiver" title="{{localize 'VIT.RemoveChargeReceiver'}}" aria-label="{{localize 'VIT.RemoveChargeReceiver'}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}</div>{{else}}<p>{{localize 'VIT.ChargeReceiverDropHint'}}</p>{{#if system.chargeReceiverId}}<p class="vit-hint">{{localize 'VIT.ChargeReceiverMissing'}}</p>{{#if editable}}<button type="button" data-action="clearChargeReceiver">{{localize 'VIT.RemoveChargeReceiver'}}</button>{{/if}}{{/if}}{{/if}}
{{#if chargeReceiver}}<label class="vit-check-label"><input type="checkbox" name="system.chargeRestoreFull" {{checked system.chargeRestoreFull}} {{#unless editable}}disabled{{/unless}}>{{localize 'VIT.ChargeRestoreFull'}}</label>
{{#unless system.chargeRestoreFull}}<label>{{localize 'VIT.RestoreChargeAmount'}}<input type="number" name="system.restoreChargeAmount" value="{{system.restoreChargeAmount}}" min="1" step="1" {{#unless editable}}disabled{{/unless}}></label>{{/unless}}{{/if}}<p class="vit-hint">{{localize 'VIT.ChargeReceiverHint'}}</p></section>
</div></details>
<details class="vit-item-group" data-item-group="effects" ><summary><span>{{localize 'VIT.AMEffectsHeader'}}</span> {{#if system.effectEnabled}}<small>{{localize 'VIT.AMyes'}}</small>{{/if}}</summary><div class="vit-item-group-content">
<label class="vit-check-label"><input type="checkbox" name="system.effectEnabled" {{checked system.effectEnabled}} {{#unless editable}}disabled{{/unless}}>{{localize 'VIT.EffectEnabled'}}</label>
{{#if system.effectEnabled}}<label>{{localize 'VIT.EffectBranch'}}<select name="system.effectBranch" {{#unless editable}}disabled{{/unless}}>{{selectOptions branches selected=system.effectBranch}}</select></label><label>{{localize 'VIT.EffectName'}}<input name="system.effectName" value="{{system.effectName}}" placeholder="{{item.name}}" {{#unless editable}}disabled{{/unless}}></label>
<label>{{localize 'VIT.EffectRecipient'}}<select name="system.effectTarget" {{#unless editable}}disabled{{/unless}}>{{selectOptions effectTargets selected=system.effectTarget}}</select></label>
<label>{{localize 'VIT.Attribute'}}<select name="system.effectAttribute" {{#unless editable}}disabled{{/unless}}>{{selectOptions effectAttributes selected=system.effectAttribute}}</select></label>
<label>{{localize 'VIT.EffectBonus'}}<input type="number" name="system.effectBonus" value="{{system.effectBonus}}" min="-6" max="6" step="1" {{#unless editable}}disabled{{/unless}}></label>{{/if}}
<p class="vit-hint">{{localize 'VIT.EffectHint'}}</p>
</div></details>
<details class="vit-item-group" data-item-group="area" ><summary><span>{{localize 'VIT.AreaOfUse'}}</span> {{#if system.areaEnabled}}<small>{{lookup areaShapes system.areaShape}}</small>{{/if}}</summary><div class="vit-item-group-content">
<label class="vit-check-label"><input type="checkbox" name="system.areaEnabled" {{checked system.areaEnabled}} {{#unless editable}}disabled{{/unless}}>{{localize 'VIT.AreaEnabled'}}</label>
{{#if system.areaEnabled}}<label>{{localize 'VIT.AreaPlacement'}}<select name="system.areaPlacement" {{#unless editable}}disabled{{/unless}}>{{selectOptions areaPlacements selected=system.areaPlacement}}</select></label><label>{{localize 'VIT.AreaShape'}}<select name="system.areaShape" {{#unless editable}}disabled{{/unless}}>{{selectOptions areaShapes selected=system.areaShape}}</select></label>
<label>{{localize 'VIT.AreaSize'}}<input type="number" name="system.areaSize" value="{{system.areaSize}}" min="0.1" max="1000" step="0.1" {{#unless editable}}disabled{{/unless}}></label>
<label>{{localize 'VIT.AreaWidth'}}<input type="number" name="system.areaWidth" value="{{system.areaWidth}}" min="0.1" max="1000" step="0.1" {{#unless editable}}disabled{{/unless}}></label>
<label>{{localize 'VIT.AreaAngle'}}<input type="number" name="system.areaAngle" value="{{system.areaAngle}}" min="1" max="360" step="1" {{#unless editable}}disabled{{/unless}}></label>
<p class="vit-hint">{{localize 'VIT.AreaHint'}}</p>{{/if}}
</div></details>
</section>
{{#if editable}}<div class="vit-item-actions"><button type="submit">{{localize 'VIT.SaveSettings'}}</button>{{#if canUse}}<button type="button" data-action="rollItem" {{#if useDisabled}}disabled title="{{useReason}}"{{/if}}><i class="fa-solid fa-dice-d6"></i> {{localize 'VIT.UseItem'}}</button>{{/if}}<button type="button" data-action="publish">{{localize 'VIT.Publish'}}</button></div>{{/if}}</div>
{{else}}<div class="vit-item-body vit-item-reading">
<header><img src="{{item.img}}" alt="{{item.name}}"><strong>{{item.name}}</strong><span class="vit-item-price">{{localize 'VIT.Price'}}: {{system.price}}</span></header>
<p class="vit-hint">{{lookup categories category}}{{#if system.hasTier}} · {{localize 'VIT.Tier'}}: {{system.tier}}{{/if}}</p>
<details class="vit-item-group" data-item-group="public-description" open><summary>{{localize 'VIT.PublicDescription'}}</summary><div class="vit-rich-view vit-item-rich">{{{descriptionHTML}}}</div></details>
{{#if canEditItem}}<details class="vit-item-group" data-item-group="private-description" open><summary>{{localize 'VIT.PrivateDescription'}}</summary><div class="vit-rich-view vit-item-rich">{{{privateDescriptionHTML}}}</div></details>{{/if}}
{{#if canEditItem}}<div class="vit-item-actions">{{#if canUse}}<button type="button" data-action="rollItem" {{#if useDisabled}}disabled title="{{useReason}}"{{/if}}>{{localize 'VIT.UseItem'}}</button>{{/if}}<button type="button" data-action="publish">{{localize 'VIT.Publish'}}</button></div>{{/if}}
</div>{{/if}}
</div>
