<div class="vit-roll-form"><h2>{{localize 'VIT.MovementCalculation'}}</h2><label><input type="checkbox" name="enabled" {{checked enabled}}>{{localize 'VIT.MovementBudgetEnabled'}}</label><p>{{localize 'VIT.MovementBudgetHint'}}</p>{{#each rows}}<label>{{localize 'VIT.movement'}} {{attribute}}<input type="number" name="movement{{attribute}}" value="{{value}}" min="0" step="0.1" required></label>{{/each}}<p>{{localize 'VIT.MovementColors'}}</p><button type="submit">{{localize 'VIT.SaveSettings'}}</button></div>
